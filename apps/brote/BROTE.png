<?xml version="1.0" encoding="UTF-8"?>
<svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="512" height="512" fill="#1DB679"/>

  <!-- Main circle ring - white outer -->
  <circle cx="256" cy="256" r="180" fill="none" stroke="white" stroke-width="35"/>

  <!-- Dark accent segment (bottom right) -->
  <path d="M 395 256 A 139 139 0 0 1 350 395" fill="none" stroke="#0D7F56" stroke-width="35" stroke-linecap="round"/>

  <!-- Center white circle -->
  <circle cx="256" cy="256" r="115" fill="white"/>

  <!-- Leaf design on top -->
  <g transform="translate(256, 120)">
    <!-- Left leaf -->
    <ellipse cx="-35" cy="0" rx="20" ry="35" fill="white" opacity="0.9" transform="rotate(-35 -35 0)"/>
    <!-- Right leaf -->
    <ellipse cx="35" cy="0" rx="20" ry="35" fill="white" opacity="0.9" transform="rotate(35 35 0)"/>
    <!-- Stem -->
    <rect x="-3" y="0" width="6" height="35" fill="#1DB679" rx="3"/>
  </g>
</svg>